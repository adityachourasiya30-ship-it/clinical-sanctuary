# ========================================================
# Clinical Sanctuary — Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Leave empty or set to "memory" for zero-setup in-memory MongoDB in dev
# Or provide standard MongoDB URI e.g. mongodb://localhost:27017/clinical_sanctuary
MONGODB_URI=mongodb://localhost:27017/clinical_sanctuary

# Authentication Secrets
# Generate a secure 64-char string for production: `openssl rand -hex 32`
JWT_SECRET=clinical_sanctuary_super_secret_jwt_key_academic_2026_mits
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 / Google Identity Services (GIS)
# Create in Google Cloud Console -> APIs & Services -> Credentials
# Required for Google One-Tap and Google Sign-In verification
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Emergency SMS Service (Twilio)
# When credentials are provided, real SMS alerts are sent to emergency contacts.
# When omitted, the built-in Dev Notification Provider simulates dispatches safely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Emergency Audio Evidence Storage
AUDIO_UPLOAD_DIR=uploads/audio
MAX_AUDIO_SIZE_MB=25
AUDIO_RETENTION_HOURS=72

# External Services
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ========================================================
# Clinical Sanctuary (ClinicalGuard) — Environment Configuration
# Tagline: Precision in every Response
# ========================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Community or Atlas Cloud)
# Local Community Server: mongodb://127.0.0.1:27017/emergency_alert_system
# Atlas Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/emergency_alert_system
MONGODB_URI=mongodb://127.0.0.1:27017/emergency_alert_system

# Authentication & Session Security
# Production requirement: Generate a 64-char random hex: `openssl rand -hex 32`
JWT_SECRET=clinical_sanctuary_dev_secret_mits_2026_key
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 / Google Identity Services (GIS)
# Register at: https://console.cloud.google.com -> APIs & Services -> Credentials
# Configure Authorized JavaScript Origins: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Emergency SMS Service (Twilio Carrier Integration)
# Optional in development. When blank, the platform uses DevNotificationProvider
# to write simulated audit logs without charging SMS fees.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Emergency Audio Evidence Storage
AUDIO_UPLOAD_DIR=uploads/audio
MAX_AUDIO_SIZE_MB=25
AUDIO_RETENTION_HOURS=72

# Public Mapping & Hospital Discovery Service
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
